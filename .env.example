# Seven Gates mobile PDF publisher
# Configure these in Vercel Project Settings -> Environment Variables.
PUBLISH_ADMIN_PASSWORD=
# Optional separate HMAC secret. If omitted, the admin password signs the session cookie.
PUBLISH_ADMIN_SECRET=
# Fine-grained GitHub token: Contents read/write on oged/sevengatesresearch.com
GITHUB_TOKEN=
GITHUB_REPO=oged/sevengatesresearch.com
GITHUB_BRANCH=main
